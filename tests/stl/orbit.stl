// SP, CU and MCR( end the logic string: the OR term before them does not reach A I2
tag I0 Bool %I0.0
tag I1 Bool %I0.1
tag I2 Bool %I0.2
tag Q0 Bool %Q0.0
tag Q1 Bool %Q0.1
tag Q2 Bool %Q0.2
A I0
O
A I1
L s5:1000
SP T 1
A I2
= Q0
---
A I0
O
A I1
CU C 1
A I2
= Q1
---
MCRA
A I0
O
A I1
MCR(
A I2
= Q2
)MCR
MCRD
