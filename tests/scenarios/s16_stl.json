{
  "comment": "The fixture s16_stl of tiaconv (TIA Portal V21, CPU 1511-1 PN): STL with absolute and indirect addresses, local data by address, S5 timers and counters in STL, LAD and FBD. The values are worked out by hand from the code. Note that MW30 (Tag_6) lies in MD28 (Tag_5), so Tag_5 ends as 5, not as RND 2.5.",
  "program": "../data/S16PLC.json",
  "scan_ms": 10,
  "steps": [
    {"comment": "A: power on, all inputs off",
     "run_ms": 100,
     "expect": {"Out1": false, "Out2": false, "Out3": false, "Tag_3": 10, "Tag_5": 5,
                "\"S16Data\".b0": false, "\"S16Data\".b1": true, "\"S16Data\".by": 7, "\"S16Data\".w": 1234,
                "\"S16Data\".arr[1]": 1235, "\"S16Data\".arr[2]": 0, "\"S16Data\".arr[3]": 42, "\"S16Data\".r": 2.5,
                "Tag_6": 5, "Tag_8": 1234, "Tag_9": true, "Tag_10": 42, "Tag_11": 77,
                "Out4": false, "Out5": false, "Out6": false, "Tag_15": 0,
                "Out8": false, "Tag_26": false, "Tag_28": false, "Tag_31": false, "Tag_33": false}},

    {"comment": "B: Start: the pulse (S_PULSE, 1 s) is on, the delays (2 s, 3 s) run",
     "set": {"Start": true}, "run_ms": 500,
     "expect": {"Out2": true, "Tag_33": true, "Out4": false, "Tag_19": false, "Out8": false}},
    {"comment": "C: 2.1 s: SD T1 and SD T2 are on, the pulse is over, T1 has no time left",
     "run_ms": 1600,
     "expect": {"Out4": true, "Tag_19": true, "Tag_33": false, "Out8": false, "Tag_13": 0, "Tag_14": 0}},
    {"comment": "D: 3.1 s: S_ODT T3 is on, no time left",
     "run_ms": 1000,
     "expect": {"Out8": true, "Tag_23": 0, "Tag_24": 0}},
    {"comment": "E: Rst resets T1 and T3 while Start stays on",
     "set": {"Rst": true}, "run_ms": 50,
     "expect": {"Out4": false, "Out8": false, "Tag_19": true}},

    {"comment": "F: Stop on: the off delay SF is on at once",
     "set": {"Rst": false, "Start": false, "Stop": true}, "run_ms": 50,
     "expect": {"Out5": true, "Out1": false}},
    {"comment": "F: Stop off: on for 1 s more", "set": {"Stop": false}, "run_ms": 500,
     "expect": {"Out5": true}},
    {"run_ms": 600, "expect": {"Out5": false}},

    {"comment": "G: four times Up: S5 counters C3 (STL), C2 (S_CUD), C5 (CU coil); the edge in StlLogic",
     "set": {"Up": true}, "run_ms": 20}, {"set": {"Up": false}, "run_ms": 20},
    {"set": {"Up": true}, "run_ms": 20}, {"set": {"Up": false}, "run_ms": 20},
    {"set": {"Up": true}, "run_ms": 20}, {"set": {"Up": false}, "run_ms": 20},
    {"set": {"Up": true}, "run_ms": 20}, {"set": {"Up": false}, "run_ms": 20,
     "expect": {"Tag_15": 4, "Tag_16": 4, "Out6": true, "Tag_29": 4, "Tag_28": true, "Tag_31": true,
                "Tag_2": 4, "Tag_4": 12, "Out3": true}},
    {"comment": "G: Down once: C3 and C2 count down, the coil counter C5 not",
     "set": {"Down": true}, "run_ms": 20}, {"set": {"Down": false}, "run_ms": 20,
     "expect": {"Tag_15": 3, "Tag_29": 3}},

    {"comment": "H: SetC: C3 to C#5, C2 to C#7, C5 to C#3",
     "set": {"SetC": true}, "run_ms": 20}, {"set": {"SetC": false}, "run_ms": 20,
     "expect": {"Tag_15": 5, "Tag_16": 5, "Tag_29": 7, "Out6": true}},
    {"comment": "H: seven times Up: C3 at 12, LC gives it in BCD",
     "set": {"Up": true}, "run_ms": 20}, {"set": {"Up": false}, "run_ms": 20},
    {"set": {"Up": true}, "run_ms": 20}, {"set": {"Up": false}, "run_ms": 20},
    {"set": {"Up": true}, "run_ms": 20}, {"set": {"Up": false}, "run_ms": 20},
    {"set": {"Up": true}, "run_ms": 20}, {"set": {"Up": false}, "run_ms": 20},
    {"set": {"Up": true}, "run_ms": 20}, {"set": {"Up": false}, "run_ms": 20},
    {"set": {"Up": true}, "run_ms": 20}, {"set": {"Up": false}, "run_ms": 20},
    {"set": {"Up": true}, "run_ms": 20}, {"set": {"Up": false}, "run_ms": 20,
     "expect": {"Tag_15": 12, "Tag_16": 18, "Tag_29": 14}},

    {"comment": "I: Level: CU of C4 (the block typed in German), the SD coil on T4 (500 ms), Out1",
     "set": {"Level": true}, "run_ms": 300,
     "expect": {"Tag_21": 1, "Tag_26": false, "Out1": true}},
    {"run_ms": 300, "expect": {"Tag_26": true}},
    {"comment": "J: Rst: C3 and C2 to 0, T4 reset by the R coil; C5 stays",
     "set": {"Rst": true}, "run_ms": 30,
     "expect": {"Tag_15": 0, "Out6": false, "Tag_29": 0, "Tag_28": false, "Tag_26": false, "Tag_31": true, "Out1": false}}
  ]
}
