{
  "comment": "The fixture s14_code_rewritten: LAD, FBD and SCL in one program; ZZSCL is know-how protected; ZZSTL and ZZSTL2 are in STL. The values are derived by hand from the code (tiaconv tools/program_tree.py).",
  "program": "../data/ZZPLC.json",
  "scan_ms": 10,
  "steps": [
    {"comment": "first cycle with ZZALPHA on; ZZSTL2 jumps over L 1, T ZZN1 and calls ZZFB with ZZB (FALSE)", "set": {"ZZALPHA": true}, "scans": 1,
     "expect": {"ZZOUT": false, "ZZC": false, "ZZN1": 10, "ZZN2": 6, "ZZN3": 7,
                "\"ZZDATA\".run": true, "\"ZZDATA\".speed": 0,
                "\"ZZFB_DB\".out1": false, "\"ZZOUTER_DB\".inner.out1": false, "\"ZZOUTER_DB\".inner.io1": 0,
                "\"ZZLAD2_DB\".IEC_Counter_0_Instance.CV": 1, "\"ZZLAD2_DB\".count": 5}},
    {"comment": "second cycle: REPEAT runs once, CASE takes ELSE, ZZN3 ends as ZZK; ZZFB got ZZN2 as io1, last from ZZSTL2 (7)", "scans": 1,
     "expect": {"ZZN1": 10, "ZZN2": 7, "ZZN3": 7, "ZZC": false, "\"ZZLAD2_DB\".IEC_Counter_0_Instance.CV": 1,
                "\"ZZFB_DB\".io1": 7}},
    {"comment": "after 2.5 s the 2 s timer in ZZLAD2 is on", "run_ms": 2500,
     "expect": {"ZZOUT": true, "\"ZZLAD2_DB\".IEC_Timer_0_Instance.Q": true,
                "\"IEC_Timer_0_DB\".Q": false, "\"IEC_Timer_0_DB\".ET": "T#2510ms"}},
    {"comment": "after 5 s the timer in Main too; ZZC is written again later in the cycle", "run_ms": 3000,
     "expect": {"\"IEC_Timer_0_DB\".Q": true, "\"IEC_Timer_0_DB\".ET": "T#5s", "ZZC": false, "ZZOUT": true}},
    {"comment": "ZZALPHA off: ZZSTL2 does not jump, L 1, T ZZN1", "set": {"ZZALPHA": false}, "scans": 1,
     "expect": {"ZZN1": 1, "ZZOUT": false, "ZZC": false, "\"ZZDATA\".run": false, "\"ZZFB_DB\".out1": false,
                "\"IEC_Timer_0_DB\".Q": false, "\"IEC_Timer_0_DB\".ET": "T#0s",
                "\"ZZLAD2_DB\".IEC_Counter_0_Instance.CV": 1}},
    {"comment": "ZZALPHA on again: the counter counts", "set": {"ZZALPHA": true}, "scans": 1,
     "expect": {"\"ZZLAD2_DB\".IEC_Counter_0_Instance.CV": 2, "\"ZZDATA\".run": true}},
    {"comment": "ZZB on: the counter is reset; P sets ZZC, N clears it again", "set": {"ZZB": true}, "scans": 1,
     "expect": {"\"ZZLAD2_DB\".IEC_Counter_0_Instance.CV": 0, "ZZC": false, "\"ZZLAD2_DB\".edgeP": true,
                "\"ZZLAD2_DB\".memN": true, "\"ZZDATA\".run": false, "\"ZZOUTER_DB\".inner.out1": true}},
    {"set": {"ZZB": false, "ZZALPHA": false}, "scans": 1},
    {"set": {"ZZALPHA": true}, "scans": 1},
    {"set": {"ZZALPHA": false}, "scans": 1},
    {"set": {"ZZALPHA": true}, "scans": 1},
    {"set": {"ZZALPHA": false}, "scans": 1},
    {"set": {"ZZALPHA": true, "\"ZZDB2\".d1": 42, "\"ZZDB2\".d4": 42}, "scans": 1,
     "expect": {"\"ZZLAD2_DB\".IEC_Counter_0_Instance.CV": 3, "ZZN3": 7}},
    {"comment": "STOP to RUN: the counter instance and ZZDB2.d4 are retentive", "restart": "warm",
     "expect": {"\"ZZLAD2_DB\".IEC_Counter_0_Instance.CV": 3, "\"ZZDB2\".d4": 42, "\"ZZDB2\".d1": 0,
                "ZZN1": 0, "ZZN2": 0, "\"ZZDATA\".run": false, "\"IEC_Timer_0_DB\".ET": "T#0s"}},
    {"comment": "ZZN1 over 100: Main copies ZZN2 to speed before ZZSCL2 counts it up (ZZALPHA on: ZZSTL2 leaves ZZN1)", "set": {"ZZN1": 200, "ZZALPHA": true},
     "scans": 2,
     "expect": {"\"ZZDATA\".speed": 6, "ZZN1": 200, "ZZN2": 7, "ZZN3": 7}},
    {"comment": "power off and on: the retentive counter value and d4 kept, the rest to its start values", "restart": "power",
     "expect": {"\"ZZLAD2_DB\".IEC_Counter_0_Instance.CV": 3, "\"ZZDB2\".d4": 42, "\"ZZDATA\".speed": 0}},
    {"comment": "memory reset: everything back to the start values", "restart": "reset",
     "expect": {"\"ZZLAD2_DB\".IEC_Counter_0_Instance.CV": 0, "\"ZZDB2\".d4": 0, "\"ZZLAD2_DB\".count": 5,
                "\"ZZDATA\".speed": 0}}
  ]
}
